name: Publish Fork Release

on:
    push:
        tags:
            - "v*"
    workflow_dispatch:

permissions:
    contents: write

jobs:
    publish_windows:
        name: Publish Windows fork installer
        runs-on: windows-2022

        steps:
            - name: Check out Git repository
              uses: actions/checkout@v4

            - name: Install Node.js and npm
              uses: actions/setup-node@v4
              with:
                  node-version: 22

            - name: Install dependencies
              run: npm ci

            - name: Required test suite
              run: npm run test:ci

            - name: Build Electron application for smoke tests
              run: npm run build

            - name: Electron adversarial workflows
              run: npm run test:playwright

            - name: Build and publish fork release
              env:
                  GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
              run: npm run release:fork
