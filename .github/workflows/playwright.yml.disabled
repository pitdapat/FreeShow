name: Playwright Tests
on:
    pull_request:
    push:
        branches: [main]
    workflow_dispatch:

jobs:
    test:
        timeout-minutes: 60
        runs-on: windows-2022
        steps:
            - uses: actions/checkout@v4
            - uses: actions/setup-node@v4
              with:
                  node-version: 22
            - name: Install dependencies
              run: npm ci
            - name: Build
              run: npm run build
            - name: Run Playwright tests
              id: electron
              run: npm run test:playwright
              continue-on-error: true
            - name: Record Electron qualification outcome
              if: always()
              run: |
                  echo "Electron qualification run (require after 20 consecutive clean runs): ${{ steps.electron.outcome }}" >> "$env:GITHUB_STEP_SUMMARY"
            - uses: actions/upload-artifact@v4
              if: always()
              with:
                  name: test-output
                  path: test-output/
                  retention-days: 30
